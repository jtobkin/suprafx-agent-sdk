{
  "name": "suprafx-agent-sdk",
  "version": "0.3.0",
  "description": "SDK + MCP server for building autonomous agents on SupraFX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtobkin/suprafx-agent-sdk.git"
  },
  "homepage": "https://suprafx.ai/agents",
  "bin": {
    "suprafx-mcp": "dist/bin/suprafx-mcp.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./signer": {
      "import": "./dist/src/signer.js",
      "types": "./dist/src/signer.d.ts"
    },
    "./client": {
      "import": "./dist/src/client.js",
      "types": "./dist/src/client.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "mcp": "node dist/bin/suprafx-mcp.js",
    "test": "npx tsx --test test/*.test.ts src/mcp/*.test.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eventsource": "^3.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "suprafx",
    "mcp",
    "model-context-protocol",
    "trading",
    "ai-agent",
    "market-maker",
    "bft"
  ]
}
